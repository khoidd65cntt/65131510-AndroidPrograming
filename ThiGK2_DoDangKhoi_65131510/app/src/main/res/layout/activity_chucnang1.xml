<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">
    <EditText android:id="@+id/edtVND" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Nhập số tiền (đô la)" android:inputType="numberDecimal" />
    <EditText android:id="@+id/edtTiGia" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Nhập tỉ giá" android:inputType="numberDecimal" />
    <Button android:id="@+id/btnChuyenDoi" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Chuyển đổi" />
    <TextView android:id="@+id/tvKetQua" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="18sp" android:layout_marginTop="16dp" />
</LinearLayout>